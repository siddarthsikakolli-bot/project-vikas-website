---
import Base from '../layouts/Base.astro';
import RunningHead from '../components/RunningHead.astro';
import NoticeField from '../components/NoticeField.astro';
import Statement from '../components/Statement.astro';
import Appearance from '../components/Appearance.astro';
import CauseList from '../components/CauseList.astro';
import WhatWeDo from '../components/WhatWeDo.astro';
import Figures from '../components/Figures.astro';
import Waiting from '../components/Waiting.astro';
import Colophon from '../components/Colophon.astro';
---

<Base>
  <RunningHead />
  <main id="main">
    <NoticeField />
    <Statement />
    <Appearance />
    <CauseList />
    <WhatWeDo />
    <Figures />
    <Waiting />
  </main>
  <Colophon />
</Base>
