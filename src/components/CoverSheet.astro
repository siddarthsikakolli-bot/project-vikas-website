---
/* Section 01 — the cover sheet.
   A case caption, read as one legal sentence:

     In the matter of ACCESS TO LEGAL REPRESENTATION
     ————————— , appearing without counsel
     Project Vikas, entering an appearance

   The SUBJECT carries the largest type, not the organisation's
   name. A first-time visitor should learn what this is about
   before they learn who we are. See hero.css for the two beats. */
import '../styles/hero.css';
import { org, mission, cover } from '../content/site';
---

<section class="cover" aria-labelledby="cover-subject">

  {/* Plate. Abstract texture, no subject — nothing that could be
      read as documentation. The still is always present; the
      video layers over it and is dropped under reduced motion. */}
  <img
    class="cover__plate"
    src="/media/hero-plate.jpg"
    alt=""
    aria-hidden="true"
    decoding="async"
    fetchpriority="high"
  />
  <video
    class="cover__plate cover__plate--video"
    src="/media/hero.mp4"
    poster="/media/hero-plate.jpg"
    autoplay muted loop playsinline
    aria-hidden="true"
    tabindex="-1"
  ></video>

  <div class="sheet">

    <p class="cover__matter">{cover.matterLine}</p>
    <h1 class="cover__subject" id="cover-subject">{cover.subject}</h1>

    <hr class="cover__caption-rule" />

    <div class="cover__caption">
      <div>
        {/* The vacancy, running the full measure. Never filled —
            nothing here may resemble a real party to a real matter. */}
        <div class="cover__vacancy" aria-hidden="true">
          <span class="blank"></span>
        </div>
        <p class="cover__vacancy-note">— <em>{cover.vacancyNote}</em></p>

        {/* The entry. Outline resolving to ink. */}
        <p class="cover__counsel" data-text={org.name}>{org.name}</p>
        <p class="cover__counsel-note">— <em>{cover.counselNote}</em></p>
      </div>

      <div class="cover__meta">
        {cover.particulars.map((p) => (
          <div>{p.label} <b>{p.value}</b></div>
        ))}
      </div>
    </div>

    <hr class="cover__rule" />

    <div class="cover__body">
      {/* CONTENT SLOT — mission. Factual description only. */}
      <p class="cover__lede">
        {mission.lede} — <em>{mission.ledeQualifier}</em>
      </p>

      <div class="cover__act">
        <a class="action action--dark" href={org.donateUrl} rel="noopener">Donate</a>
        <a class="cover__cue" href="#cause-list">
          <span class="arrow" aria-hidden="true"></span>
          <span>Read the record</span>
        </a>
      </div>
    </div>

  </div>
</section>

<script>
  /* Start the two-beat entry once the display face has loaded.
     Caslon Display and the Georgia fallback have different metrics,
     so firing early makes the solid copy wipe across letterforms
     that are about to reflow.

     The page is complete without this script: CSS defaults are the
     finished state, and only the .js class (set inline in <head>)
     opts into the pre-animation state. */
  const root = document.documentElement;

  function reveal() { root.classList.add('is-ready'); }

  function begin() {
    // Two frames, so the pre-animation state is painted at least once
    // and the browser does not collapse the transition.
    requestAnimationFrame(() => requestAnimationFrame(reveal));
    // rAF is throttled or paused where the document is not being
    // painted. Without this the caption would sit in its
    // pre-animation state — a zero-width rule and outline-only
    // name — rather than its finished one. Adding the class twice
    // is harmless.
    setTimeout(reveal, 400);
  }

  if (document.fonts && document.fonts.ready) {
    let started = false;
    const start = () => { if (!started) { started = true; begin(); } };
    document.fonts.ready.then(start);
    setTimeout(start, 1200);
  } else {
    begin();
  }
</script>
