---
import { org, nav } from '../content/site';
const [first, second] = org.nameParts;
---

<header class="site-header">
  <div class="wrap">
    <a class="wordmark" href="/">{first} <span class="mark-v">{second}</span></a>
    <nav class="site-nav" aria-label="Primary">
      <div class="nav-links">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
      <a class="btn-donate" href={org.donateUrl} rel="noopener">Donate</a>
    </nav>
  </div>
</header>
