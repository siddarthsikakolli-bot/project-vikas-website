---
/* ============================================================
   Section 01 — "Entering an appearance"
   ------------------------------------------------------------
   An *appearance* is the formal act of counsel joining a case:
   the moment a represented party stops being a blank in the
   record. The name arrives in outline, a brass rule is drawn
   beneath it, and the letters fill solid as the rule completes —
   absence resolving into presence, in one gesture.

   Jurisdiction-neutral: every legal system keeps a record and
   names the parties in it.
   ============================================================ */
import '../styles/hero.css';
import { org, mission } from '../content/site';
---

<section class="hero" aria-labelledby="hero-name">

  {/*
    Hero plate. Abstract macro texture — no subject, nothing that
    could read as documentation. The still is always present; the
    video layers over it and is dropped entirely under
    prefers-reduced-motion, so the plate never disappears.
  */}
  <img
    class="hero__plate"
    src="/media/hero-plate.jpg"
    alt=""
    aria-hidden="true"
    decoding="async"
    fetchpriority="high"
  />
  <video
    class="hero__plate hero__plate--video"
    src="/media/hero.mp4"
    poster="/media/hero-plate.jpg"
    autoplay
    muted
    loop
    playsinline
    aria-hidden="true"
    tabindex="-1"
  ></video>

  <div class="wrap">

    <p class="hero__eyebrow">
      <span>Est. {org.founded}</span>
      <span aria-hidden="true">·</span>
      <span>Fiscally sponsored by {org.fiscalSponsor.name}</span>
      <span aria-hidden="true">·</span>
      <span class="cert">{org.fiscalSponsor.status}</span>
    </p>

    <p class="hero__caption">In the matter of</p>

    <h1 class="appearance" id="hero-name" data-text={org.name}>{org.name}</h1>
    <div class="appearance__rule" aria-hidden="true"></div>

    <div class="hero__body">
      <p class="hero__lede">
        {mission.lede} — <em>{mission.ledeQualifier}</em>
      </p>

      <div class="hero__actions">
        <a class="btn btn--primary" href={org.donateUrl} rel="noopener">Donate</a>
        <a class="btn btn--ghost" href="#involved">Volunteer</a>
      </div>
    </div>

    <a class="hero__cue" href="#cause-list">
      <span class="arrow" aria-hidden="true"></span>
      <span>The cause list</span>
    </a>

  </div>
</section>

<script>
  /* The only job here is to start the animation once the display
     face has actually loaded. Archivo 900 and the fallback stack
     have very different metrics, so firing on DOMContentLoaded
     makes the solid copy wipe across letterforms that are about
     to reflow.

     The page is fully readable with this script absent: the CSS
     default is the finished state, and only the .js class (set
     inline in <head>) opts into the pre-animation state. */
  const root = document.documentElement;

  function begin() {
    // Two frames, so the pre-animation state is painted at least
    // once — otherwise the browser may collapse it and skip the wipe.
    requestAnimationFrame(() => {
      requestAnimationFrame(() => root.classList.add('is-ready'));
    });
  }

  if (document.fonts && document.fonts.ready) {
    let started = false;
    const start = () => {
      if (started) return;
      started = true;
      begin();
    };
    document.fonts.ready.then(start);
    // Never wait indefinitely on a font that fails to arrive.
    setTimeout(start, 1200);
  } else {
    begin();
  }
</script>
