---
/* Section 02 — the cause list. */
import '../styles/causelist.css';
import { causeList } from '../content/site';
---

<section class="sheet" id="cause-list" aria-labelledby="cause-list-head">
  <div class="doc">

    <h2 class="sec-head" id="cause-list-head">
      <span class="n">02</span>{causeList.heading}
    </h2>

    {causeList.paras.map((p) => (
      <div class="para">
        <div class="pnum">{p.n}</div>
        <div class="ptext"><p>{p.text}</p></div>
        <div class="marg">
          {p.note && <><b>{p.note.label}</b>{p.note.text}</>}
        </div>
      </div>
    ))}

    <div class="causelist">
      <div class="causelist__head">
        <span>No.</span>
        <span>Matter</span>
        <span>Standing</span>
      </div>

      {causeList.rows.map((row) => (
        <div class={`causelist__row${row.heard ? ' causelist__row--heard' : ''}`}>
          <div class="causelist__n">{row.n}</div>
          <div class="causelist__matter">
            In the matter of <span class={`causelist__blank${row.heard ? ' causelist__counsel' : ''}`}></span>
          </div>
          <div class="causelist__status">{row.status}</div>
        </div>
      ))}

      <p class="causelist__note"><b>Note.</b> {causeList.note}</p>
    </div>

  </div>
</section>
