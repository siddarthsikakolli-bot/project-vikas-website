---
/* Where a document records its own provenance. */
import { org, mission, footerNav, footerConnect } from '../content/site';
const [first, second] = org.nameParts;
const year = new Date().getFullYear();
---

<footer class="colophon" id="contact">
  <div class="sheet">
    <div class="colophon__grid">

      <div class="colophon__mark">§</div>

      <div class="colophon__body">
        <p class="name">{first} <span class="accent">{second}</span></p>
        <p>{mission.short}</p>
        <p><a href={`mailto:${org.email}`}>{org.email}</a></p>
      </div>

      <div class="colophon__links">
        <ul>
          {footerNav.map((item) => (
            <li><a href={item.href} rel={item.href.startsWith('http') ? 'noopener' : undefined}>{item.label}</a></li>
          ))}
        </ul>
        <ul>
          {footerConnect.map((item) => (
            <li><a href={item.href} rel={item.href.startsWith('http') ? 'noopener' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </div>

    </div>

    <div class="registration">
      <p>
        {org.name} operates under the fiscal sponsorship of
        <a href={org.fiscalSponsor.url} rel="noopener">{org.fiscalSponsor.name}</a>,
        a registered {org.fiscalSponsor.status} nonprofit organisation. We partner with
        registered legal aid organisations in India rather than providing legal
        representation directly.
      </p>
      <p>© {year} {org.name}</p>
    </div>
  </div>
</footer>
